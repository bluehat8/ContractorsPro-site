---
import BaseLayout from '@layouts/BaseLayout.astro';
import HeroSection from '@components/HeroSection.astro';
import AboutSection from '@components/AboutSection.astro';
import HowItWorksSection from '@components/HowItWorksSection.astro';
import PortfolioSection from '@components/PortfolioSection.astro';
import TestimonialsSection from '@components/TestimonialsSection.astro';
import ContactUsSection from '@components/ContactUsSection.astro';
import FAQ from '@components/FAQ.astro';
import { getSiteSettings } from '../lib/sanity/api';

const settings = await getSiteSettings();
---

<BaseLayout title={settings.siteTitle} description={settings.siteDescription}>
  <HeroSection />
  <PortfolioSection />
  <TestimonialsSection />
  <HowItWorksSection />
  <AboutSection />
  <FAQ />
  <ContactUsSection />
</BaseLayout>
