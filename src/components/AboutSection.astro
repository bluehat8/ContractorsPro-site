---
import { Image } from 'astro:assets';
import { getWhyJoin } from '../lib/sanity/api';
import twoWomenSittingImage from '/src/assets/images/two-women-sitting.png';

const whyJoin = await getWhyJoin();
const tag = whyJoin.tag || 'WHY CONTRACTORS JOIN';
const title = whyJoin.title || 'Finding consistent, quality projects is still one of the hardest parts.';
const imageAlt = whyJoin.imageAlt || 'Contractors discussing construction project blueprint.';
const items = whyJoin.items && whyJoin.items.length > 0 ? whyJoin.items : [
  {
    title: 'Our goal is simple:',
    text: 'Help subcontractors find new construction opportunities faster. Spend less time searching for leads and more time pursuing projects that fit your crews.',
  },
  {
    title: 'Direct builder demand you can act on',
    text: 'Most contractors depend on word-of-mouth referrals, cold outreach, existing relationships, or expensive lead generation. ContractorPro connects you directly with builders and project owners seeking reliable roofing, electrical, HVAC, concrete, drywall, framing, painting, plumbing, carpentry, flooring, and more.',
  },
];
const isHidden = whyJoin.hideSection ?? false;
---

{!isHidden && (
<section id="about" class="about">
  <div class="section-container">
    <span class="section-tag">{tag}</span>
    <h2 class="section-title">{title}</h2>
    <div class="about-container">
      <div class="about-image-wrapper">
        {whyJoin.imageUrl ? (
          <img
            src={whyJoin.imageUrl}
            alt={imageAlt}
            class="media about-sanity-img"
            loading="lazy"
          />
        ) : (
          <Image
            src={twoWomenSittingImage}
            alt={imageAlt}
            class="media"
          />
        )}
      </div>
      <div class="about-content">
        {
          items.map(content => (
            <>
              <h3 class="section-subtitle about-subtitle">{content.title}</h3>
              <p class="about-text">{content.text}</p>
            </>
          ))
        }
      </div>
    </div>
  </div>
</section>
)}

<style>
  .about-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--px-48);
    align-items: center;
  }

  .about-image-wrapper {
    width: 100%;
    height: 100%;
    min-height: 24rem;
    overflow: hidden;
    aspect-ratio: 4/3;
  }

  .about-sanity-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .about-content {
    max-width: 37.5rem;
  }

  .about-text {
    margin-bottom: var(--px-20);
  }

  .about-text:last-child {
    margin-bottom: 0;
  }

  @media screen and (max-width: 64rem) {
    .about-container {
      gap: var(--px-32);
    }

    .about-image-wrapper {
      min-height: 25rem;
    }

    .about-content {
      max-width: 100%;
    }
  }

  @media screen and (max-width: 48rem) {
    .about-container {
      grid-template-columns: 1fr;
      gap: var(--px-32);
    }

    .about-image-wrapper {
      min-height: 21.875rem;
      order: -1;
    }
  }
</style>
