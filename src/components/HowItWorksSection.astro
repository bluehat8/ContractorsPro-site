---
import { Image } from "astro:assets";
import consultationImage from "/src/assets/images/consultation.jpg";
import designImage from "/src/assets/images/design.jpg";
import transformImage from "/src/assets/images/transform.jpg";

const processSteps = [
    {
        id: 1,
        title: "1. Join the Network",
        description:
            "Tell us what trades you cover and where your crews can work. Founding subcontractors receive early access to residential and commercial construction opportunities.",
        image: {
            src: consultationImage,
            alt: "Subcontractor registering specialties in ContractorPro",
        },
    },
    {
        id: 2,
        title: "2. Browse & Review Projects",
        description:
            "Review residential and commercial construction opportunities that match your expertise. Check the trade needs, scope of work, budget indications, and expected timelines before you apply.",
        image: {
            src: designImage,
            alt: "Reviewing active construction project details and blueprints",
        },
    },
    {
        id: 3,
        title: "3. Connect with Builders Directly",
        description:
            "Submit your interest directly when an opportunity fits your business. Builders and homeowners review qualified subcontractors and reach out to discuss bids and contracts.",
        image: {
            src: transformImage,
            alt: "Subcontractor and general contractor working on site",
        },
    },
];
---

<section id="how-it-works" class="process">
    <div class="section-container">
        <div class="process-content">
            <span class="section-tag">HOW IT WORKS</span>
            <h2 class="section-title">A simple path from joining the network to connecting with builders.</h2>
            <div class="process-steps">
                {
                    processSteps.map((step) => (
                        <div class="process-step">
                            <div class="process-step-content">
                                <h3 class="section-subtitle process-step-title">
                                    {step.title}
                                </h3>
                                <p class="process-step-description">
                                    {step.description}
                                </p>
                            </div>
                            <div class="process-step-image-wrapper">
                                <Image
                                    src={step.image.src}
                                    alt={step.image.alt}
                                    width={1272}
                                    height={660}
                                    class="media"
                                />
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>
    </div>
</section>

<style>
    .process-steps {
        display: flex;
        flex-direction: column;
        gap: var(--px-44);
    }

    .process-step {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--px-44);
        align-items: center;
    }

    .process-step:nth-child(even) {
        direction: rtl;
    }

    .process-step:nth-child(even) .process-step-content {
        direction: ltr;
    }

    .process-step-title {
        font-size: 1.188rem;
    }

    .process-step-description {
        max-width: 31.25rem;
    }

    .process-step-image-wrapper {
        width: 100%;
        height: 100%;
        max-height: 18.5rem;
        overflow: hidden;
    }

    @media screen and (max-width: 64rem) {
        .process-step {
            gap: var(--px-32);
        }

        .process-images {
            max-height: 18rem;
        }
    }

    @media screen and (max-width: 48rem) {
        .process-steps {
            gap: var(--px-36);
        }

        .process-step {
            grid-template-columns: 1fr;
            gap: var(--px-32);
        }

        .process-step:nth-child(even) {
            direction: ltr;
        }

        .process-step-content {
            order: -1;
        }

        .process-step-description {
            max-width: 100%;
        }

        .process-images {
            max-height: 15rem;
        }
    }
</style>
