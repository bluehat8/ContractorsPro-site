---
import { Image } from "astro:assets";
import { getHowItWorksSteps, getSiteSettings } from "../lib/sanity/api";

const settings = await getSiteSettings();
const processSteps = await getHowItWorksSteps();
---

<section id="how-it-works" class="process">
    <div class="section-container">
        <div class="process-content">
            <span class="section-tag">{settings.howItWorksTag || "HOW IT WORKS"}</span>
            <h2 class="section-title">{settings.howItWorksTitle || "A simple path from joining the network to connecting with builders."}</h2>
            <div class="process-steps">
                {
                    processSteps.map((step) => {
                        const isImageString = typeof step.image === 'string';

                        return (
                            <div class="process-step">
                                <div class="process-step-content">
                                    <h3 class="section-subtitle process-step-title">
                                        {step.title}
                                    </h3>
                                    <p class="process-step-description">
                                        {step.description}
                                    </p>
                                </div>
                                <div class="process-step-image-wrapper">
                                    {isImageString ? (
                                        <img
                                            src={step.image}
                                            alt={step.imageAlt || step.title}
                                            width="1272"
                                            height="660"
                                            class="media"
                                        />
                                    ) : (
                                        <Image
                                            src={step.image}
                                            alt={step.imageAlt || step.title}
                                            width={1272}
                                            height={660}
                                            class="media"
                                        />
                                    )}
                                </div>
                            </div>
                        );
                    })
                }
            </div>
        </div>
    </div>
</section>

<style>
    .process-steps {
        display: flex;
        flex-direction: column;
        gap: var(--px-44);
    }

    .process-step {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--px-44);
        align-items: center;
    }

    .process-step:nth-child(even) {
        direction: rtl;
    }

    .process-step:nth-child(even) .process-step-content {
        direction: ltr;
    }

    .process-step-title {
        font-size: 1.188rem;
    }

    .process-step-description {
        max-width: 31.25rem;
    }

    .process-step-image-wrapper {
        width: 100%;
        height: 100%;
        max-height: 18.5rem;
        overflow: hidden;
    }

    @media screen and (max-width: 64rem) {
        .process-step {
            gap: var(--px-32);
        }

        .process-images {
            max-height: 18rem;
        }
    }

    @media screen and (max-width: 48rem) {
        .process-steps {
            gap: var(--px-36);
        }

        .process-step {
            grid-template-columns: 1fr;
            gap: var(--px-32);
        }

        .process-step:nth-child(even) {
            direction: ltr;
        }

        .process-step-content {
            order: -1;
        }

        .process-step-description {
            max-width: 100%;
        }

        .process-images {
            max-height: 15rem;
        }
    }
</style>
