---
import { SITE, SOCIALS } from "@consts";
import socialIcons from "@assets/socialIcons";
import { getSiteSettings } from "../lib/sanity/api";

const settings = await getSiteSettings();
const siteDescription = settings?.siteDescription || SITE.DESCRIPTION;
const contactEmail = settings?.contactEmail || SITE.EMAIL;
const contactPhone = settings?.contactPhone || SITE.TELEPHONE;
const currentYear = new Date().getFullYear();
---

<footer class="main-footer">
    <div class="section-container footer footer-primary">
        <div class="footer-brand">
            <a href="/" class="logo-link" aria-label="ContractorPro home">
                <img src="/logo.png" alt="ContractorPro" class="footer-logo" />
            </a>
            <p class="site-description">{siteDescription}</p>

            <address class="footer-nav-list contact-info">
                <p class="phone">
                    <span class="label">T.</span>
                    <a href={`tel:${contactPhone}`}>{contactPhone}</a>
                </p>
                <p class="email">
                    <span class="label">E.</span>
                    <a href={`mailto:${contactEmail}`}>{contactEmail}</a>
                </p>
            </address>
        </div>

        <nav class="footer-navigation" aria-label="Footer navigation">
            <div class="footer-nav-section">
                <h2 class="headline footer-heading">Platform</h2>
                <ul class="footer-nav-list">
                    <li>
                        <a href="#hero" class="footer-link">Home</a>
                    </li>
                    <li>
                        <a href="#opportunities" class="footer-link">Opportunities</a>
                    </li>
                    <li>
                        <a href="#projects" class="footer-link">Projects</a>
                    </li>
                    <li>
                        <a href="#about" class="footer-link">Why Join</a>
                    </li>
                    <li>
                        <a href="#how-it-works" class="footer-link"
                            >How it Works</a
                        >
                    </li>
                    <li>
                        <a href="#faq" class="footer-link">FAQ</a>
                    </li>
                    <li>
                        <a href="#contact" class="footer-link">Beta Access</a>
                    </li>
                </ul>
            </div>

            <div class="footer-nav-section">
                <h2 class="headline footer-heading">Connect</h2>
                <ul class="footer-nav-list social-links-list">
                    {
                        SOCIALS.map((social) => (
                            <>
                                <li class="social-item">
                                    <a
                                        href={social.HREF}
                                        aria-label={social.LABEL}
                                        class="footer-link social-link"
                                        target="_blank"
                                        rel="noopener noreferrer"
                                    >
                                        <Fragment
                                            set:html={socialIcons[social.ICON]}
                                        />
                                        {social.NAME}
                                    </a>
                                </li>
                            </>
                        ))
                    }
                </ul>
            </div>

            <div class="footer-nav-section">
                <h2 class="headline footer-heading">Legal</h2>
                <ul class="footer-nav-list">
                    <li>
                        <a href="legal/privacy" class="footer-link"
                            >Privacy Policy</a
                        >
                    </li>
                    <li>
                        <a href="legal/terms" class="footer-link"
                            >Terms & Conditions</a
                        >
                    </li>
                    <li>
                        <a href="/sitemap-index.xml" class="footer-link"
                            >SiteMap</a
                        >
                    </li>
                </ul>
            </div>
        </nav>
    </div>

    <div class="footer footer-secondary">
        <div class="copyright">
            <p>&copy; {currentYear} {SITE.COMPANY_NAME}. All rights reserved.</p>
        </div>
        <div class="location">
            <p>Connecting verified builders and subcontractors nationwide.</p>
        </div>
    </div>
</footer>

<style>
    a {
        transition: all var(--transition-short);
    }

    a:active {
        color: var(--color-text-primary);
    }

    .main-footer {
        background-color: var(--color-background);
        padding-block: var(--px-80) var(--px-28);
        padding-inline: var(--px-64);
        color: var(--color-text-dark);
        font-size: var(--text-sm);
    }

    .footer {
        display: flex;
        justify-content: space-between;
    }

    .headline {
        color: var(--color-text-primary);
    }

    .main-footer p {
        opacity: 1;
    }

    .footer-primary {
        margin-bottom: var(--px-64);
    }

    .logo {
        display: inline-block;
        margin-bottom: var(--px-28);
        font-size: var(--text-xl);
        font-weight: 700;
    }

    .footer-logo {
        height: 38px;
        width: auto;
        object-fit: contain;
        margin-bottom: var(--px-20);
        display: block;
    }

    .site-description {
        margin-bottom: var(--px-24);
    }

    .footer-navigation {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        justify-content: space-between;
        width: 100%;
        margin-left: 16%;
        gap: var(--px-64);
    }

    .footer-heading {
        margin-bottom: var(--px-16);
        font-size: var(--text-lg);
        letter-spacing: -0.02em;
        font-weight: 500;
        text-wrap: nowrap;
    }

    .footer-nav-list {
        display: inline-flex;
        flex-direction: column;
        font-size: var(--text-sm);
        gap: var(--px-8);
        text-wrap: nowrap;
    }

    .social-link {
        display: flex;
        align-items: center;
        gap: var(--px-6);
    }

    .social-link :global(svg) {
        height: var(--px-18);
    }

    .contact-info {
        font-style: normal;
    }

    .footer-secondary {
        font-weight: 500;
    }

    @media (hover: hover) and (pointer: fine) {
        a:hover {
            color: var(--color-text-primary);
        }
    }

    @media screen and (max-width: 64rem) {
        .main-footer {
            padding-top: var(--px-80);
            padding-inline: var(--px-28);
        }

        .footer {
            flex-wrap: wrap;
            gap: var(--px-48);
        }

        .footer-navigation {
            margin-left: 0;
            width: auto;
        }

        .footer-primary {
            margin-bottom: var(--px-80);
        }
    }

    @media screen and (max-width: 37.5rem) {
        .main-footer {
            padding-top: var(--px-64);
        }

        .footer-navigation {
            grid-template-columns: 1fr;
            width: 100%;
            gap: var(--px-28);
        }

        .footer-secondary {
            gap: var(--px-6) var(--px-48);
        }

        .footer-primary {
            margin-bottom: var(--px-48);
        }
    }
</style>
