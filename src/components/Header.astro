---
import { getSiteSettings } from "../lib/sanity/api";

const settings = await getSiteSettings();
const loginUrl = settings.appLoginUrl || "https://www.app.contractorspro.us/";
---

<header id="header" class="header">
    <div class="mobile-overlay"></div>
    <nav
        class="section-container nav-container"
        role="navigation"
        aria-label="Main navigation"
    >
        <div class="logo-container">
            <a href="/" class="logo" aria-label="ContractorPro home">
                <img src="/logo.png" alt="ContractorPro" class="site-logo" />
            </a>
        </div>

        <div class="nav-content">
            <ul class="nav-menu">
                <li class="nav-item">
                    <a href="#opportunities" class="nav-link">Opportunities</a>
                </li>
                <li class="nav-item">
                    <a href="#projects" class="nav-link">Projects</a>
                </li>
                <li class="nav-item">
                    <a href="#about" class="nav-link">Why Join</a>
                </li>
                <li class="nav-item">
                    <a href="#how-it-works" class="nav-link">How it Works</a>
                </li>
                <li class="nav-item">
                    <a href="#faq" class="nav-link">FAQ</a>
                </li>
                <li class="nav-item">
                    <a href="#contact" class="nav-link">Contact</a>
                </li>
            </ul>

            <div class="mobile-actions">
                <a
                    href={loginUrl}
                    class="btn-login mobile-drawer-login"
                    aria-label="Log in to ContractorPro App"
                >
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="login-icon">
                        <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4" />
                        <polyline points="10 17 15 12 10 7" />
                        <line x1="15" y1="12" x2="3" y2="12" />
                    </svg>
                    <span>Log In</span>
                </a>
                <a href="#contact" class="nav-link btns--secondary mobile-cta">
                    <span class="btn--secondary btn--secondary-unhovered"
                        >Get Early Access</span
                    >
                    <span
                        class="btn--secondary btn--secondary-hovered"
                        aria-hidden="true"
                    >
                        Get Early Access
                    </span>
                </a>
            </div>
        </div>

        <div class="header-actions">
            <!-- Desktop / Mobile Top Login Button -->
            <a
                href={loginUrl}
                class="btn-login"
                aria-label="Log in to ContractorPro App"
            >
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="login-icon">
                    <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4" />
                    <polyline points="10 17 15 12 10 7" />
                    <line x1="15" y1="12" x2="3" y2="12" />
                </svg>
                <span>Log In</span>
            </a>

            <!-- Desktop CTA -->
            <a href="#contact" class="btns--secondary desktop-cta">
                <span class="btn--secondary btn--secondary-unhovered"
                    >Get Early Access</span
                >
                <span
                    class="btn--secondary btn--secondary-hovered"
                    aria-hidden="true"
                >
                    Get Early Access
                </span>
            </a>

            <button
                class="hamburger"
                aria-label="Toggle menu"
                aria-expanded="false"
            >
                <span class="hamburger-line"></span>
                <span class="hamburger-line"></span>
                <span class="hamburger-line"></span>
            </button>
        </div>
    </nav>
</header>

<div id="trigger" class="trigger"></div>

<style>
    .header {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: var(--h-menu-bar);
        display: flex;
        padding-inline: var(--px-32);
        z-index: var(--z-max);
        transition: all var(--transition-short);
    }

    .site-logo {
        height: 38px;
        width: auto;
        object-fit: contain;
        display: block;
    }

    .nav-container {
        position: relative;
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-size: var(--text-base);
        font-weight: 500;
    }

    .hamburger {
        display: none;
        flex-direction: column;
        justify-content: space-between;
        width: var(--px-28);
        height: var(--px-18);
        background: transparent;
        border: none;
        cursor: pointer;
        padding: 0;
        z-index: var(--z-max);
    }

    .hamburger-line {
        display: block;
        width: 100%;
        height: var(--px-2);
        background-color: currentColor;
        transition: transform var(--transition-medium);
    }

    .nav-menu {
        display: flex;
    }

    .nav-item {
        margin-inline: var(--px-16);
    }

    .nav-link:not(.mobile-cta) {
        display: flex;
        opacity: 0.65;
        transition: all var(--transition-short);
    }

    .nav-link:active {
        opacity: 1;
        transform: scale(0.98);
    }

    .header-actions {
        display: flex;
        align-items: center;
        gap: var(--px-20);
    }

    .btn-login {
        display: inline-flex;
        align-items: center;
        gap: var(--px-8);
        padding: 0.45rem 1.1rem;
        font-size: var(--text-sm);
        font-weight: 500;
        color: var(--color-text-dark);
        border: 1px solid var(--color-border);
        border-radius: 9999px;
        background: transparent;
        text-decoration: none;
        transition: all var(--transition-short);
        white-space: nowrap;
    }

    .btn-login:hover {
        background: var(--color-primary);
        color: var(--color-white);
        border-color: var(--color-primary);
        transform: translateY(-1px);
        box-shadow: var(--shadow-sm);
    }

    .btn-login .login-icon {
        width: 0.95rem;
        height: 0.95rem;
        flex-shrink: 0;
    }

    .desktop-cta {
        display: inline-block;
    }

    .mobile-cta {
        display: none;
    }

    .mobile-actions {
        display: none;
    }

    .btn--secondary {
        border-bottom: var(--px-2) solid currentColor;
    }

    .btn--secondary-unhovered {
        display: block;
    }

    .btn--secondary-hovered {
        display: block;
    }

    .scrolled {
        height: var(--h-menu-bar-scrolled) !important;
        -webkit-backdrop-filter: blur(10px);
        backdrop-filter: blur(10px);
        background: rgba(255, 255, 255, 0.98);
        box-shadow: var(--shadow-header);
    }

    .mobile-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100vh;
        background-color: var(--color-overlay);
        backdrop-filter: blur(4px);
        -webkit-backdrop-filter: blur(4px);
        z-index: var(--z-50);
        opacity: 0;
        visibility: hidden;
        transition: all 0.3s ease;
    }

    .mobile-overlay.active {
        opacity: 1;
        visibility: visible;
    }

    .trigger {
        height: 1px;
    }

    @media (hover: hover) and (pointer: fine) {
        .nav-link:hover {
            opacity: 1;
        }
    }

    @media screen and (max-width: 64rem) {
        .header {
            padding-inline: var(--px-16);
        }

        .header-actions {
            gap: var(--px-12);
        }

        .header-actions .btn-login {
            padding: 0.35rem 0.85rem;
            font-size: var(--text-xs);
        }

        .desktop-cta {
            display: none;
        }

        .mobile-actions {
            display: flex;
            flex-direction: column;
            gap: var(--px-20);
            width: 100%;
        }

        .mobile-drawer-login {
            display: inline-flex;
            justify-content: center;
            width: 100%;
            padding: 0.75rem 1.25rem;
            font-size: var(--text-base);
        }

        .mobile-cta {
            display: inline-block;
        }

        .btn--secondary {
            font-size: var(--text-2xl);
        }

        .hamburger {
            display: flex;
        }

        .nav-content {
            z-index: var(--z-999);
            position: fixed;
            top: 0;
            right: -100%;
            height: 100vh;
            width: 100%;
            max-width: 18.75rem;
            background: white;
            flex-direction: column;
            padding: calc(var(--h-menu-bar) + 2rem) var(--px-16) var(--px-32);
            transition: right 0.3s ease;
            box-shadow: -5px 0 15px rgba(0, 0, 0, 0.1);
            justify-content: flex-start;
        }

        .nav-content.active {
            right: 0;
        }

        .nav-menu {
            flex-direction: column;
            gap: var(--px-20);
            margin-bottom: var(--px-40);
            justify-content: flex-start;
        }

        .nav-item {
            margin: 0;
        }

        .nav-link:not(.mobile-cta) {
            font-size: var(--text-2xl);
        }

        .hamburger.active .hamburger-line:nth-child(1) {
            transform: translateY(0.438rem) rotate(45deg);
        }

        .hamburger.active .hamburger-line:nth-child(2) {
            opacity: 0;
        }

        .hamburger.active .hamburger-line:nth-child(3) {
            transform: translateY(-0.563rem) rotate(-45deg);
        }
    }
</style>

<script>
    function observeHeader() {
        const trigger = document.getElementById("trigger");
        const header = document.getElementById("header");

        if (!trigger || !header) return;

        const observer = new IntersectionObserver(
            ([entry]) => {
                header.classList.toggle("scrolled", !entry.isIntersecting);
            },
            { threshold: 0 },
        );

        observer.observe(trigger);

        return () => observer.disconnect();
    }

    function initMobileMenu() {
        const hamburger = document.querySelector(".hamburger");
        const navContent = document.querySelector(".nav-content");
        const overlay = document.querySelector(".mobile-overlay");

        if (!hamburger || !navContent || !overlay) return;

        function closeMenu() {
            hamburger?.classList.remove("active");
            navContent?.classList.remove("active");
            overlay?.classList.remove("active");
            hamburger?.setAttribute("aria-expanded", "false");
            document.body.classList.remove("no-scroll");
        }

        function openMenu() {
            hamburger?.classList.add("active");
            navContent?.classList.add("active");
            overlay?.classList.add("active");
            hamburger?.setAttribute("aria-expanded", "true");
            document.body.classList.add("no-scroll");
        }

        const toggleMenu = () => {
            hamburger.classList.contains("active") ? closeMenu() : openMenu();
        };

        const handleEscape = (e: KeyboardEvent) => {
            if (e.key === "Escape" && hamburger.classList.contains("active")) {
                closeMenu();
            }
        };

        // Event delegation for nav links
        navContent.addEventListener("click", (e) => {
            const target = e.target as HTMLElement;
            if (target.classList.contains("nav-link")) {
                closeMenu();
            }
        });

        hamburger.addEventListener("click", toggleMenu);
        overlay.addEventListener("click", closeMenu);
        document.addEventListener("keydown", handleEscape);

        return () => {
            hamburger.removeEventListener("click", toggleMenu);
            navContent.removeEventListener("click", closeMenu);
            overlay.removeEventListener("click", closeMenu);
            document.removeEventListener("keydown", handleEscape);
        };
    }

    let headerCleanup = observeHeader();
    let menuCleanup = initMobileMenu();

    document.addEventListener("astro:after-swap", () => {
        if (headerCleanup) headerCleanup();
        if (menuCleanup) menuCleanup();
        headerCleanup = observeHeader();
        menuCleanup = initMobileMenu();
    });
</script>
