---
import { getSiteSettings } from "../lib/sanity/api";

const settings = await getSiteSettings();
const heroCtaText = settings.heroCtaText || "GET EARLY ACCESS";
const heroCtaUrl = settings.heroCtaUrl || "#contact";
const heroSecondaryCtaText = settings.heroSecondaryCtaText || "How It Works?";
const heroSecondaryCtaUrl = settings.heroSecondaryCtaUrl || "#how-it-works";

const videoUrl = settings.heroVideoUrl || "https://res.cloudinary.com/dellp9a4z/video/upload/f_mp4,q_auto,w_1080/v1774623099/ik-video_esc1gl.mp4";

// Generate MP4 & WebM URLs for universal mobile & iOS Safari support
let mp4Url = videoUrl;
let webmUrl = "";

if (videoUrl.includes("cloudinary.com")) {
    mp4Url = videoUrl
        .replace(/(\.webm|\.mp4)?$/, ".mp4")
        .replace("vc_vp9", "vc_h264")
        .replace("f_auto", "f_mp4");
    webmUrl = videoUrl
        .replace(/(\.webm|\.mp4)?$/, ".webm")
        .replace("f_mp4", "f_auto");
} else if (videoUrl.endsWith(".webm")) {
    webmUrl = videoUrl;
    mp4Url = videoUrl.replace(/\.webm$/, ".mp4");
}
---


<section id="hero" class="hero">
    <div class="section-container hero-container">
        <div class="hero-content">
            <span class="section-tag">{settings.heroTag || "SUBCONTRACTOR PROJECT ACCESS"}</span>
            <h1 class="hero-title">{settings.heroTitle || "Connect With Construction Projects Looking for Subcontractors."}</h1>
            <p class="hero-subtitle">
                {settings.heroSubtitle}
            </p>
            <div class="hero-cta">
                <a href={heroCtaUrl} class="btn btn--primary"
                    >{heroCtaText}</a
                >
                <a href={heroSecondaryCtaUrl} class="btns--secondary">
                    <span class="btn--secondary btn--secondary-unhovered">
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 384 512"
                        >
                            <path
                                d="M73 39c-14.8-9.1-33.4-9.4-48.5-.9S0 62.6 0 80L0 432c0 17.4 9.4 33.4 24.5 41.9s33.7 8.1 48.5-.9L361 297c14.3-8.7 23-24.2 23-41s-8.7-32.2-23-41L73 39z"
                            ></path>
                        </svg>
                        {heroSecondaryCtaText}
                    </span>
                    <span
                        class="btn--secondary btn--secondary-hovered"
                        aria-hidden="true"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 384 512"
                        >
                            <path
                                d="M73 39c-14.8-9.1-33.4-9.4-48.5-.9S0 62.6 0 80L0 432c0 17.4 9.4 33.4 24.5 41.9s33.7 8.1 48.5-.9L361 297c14.3-8.7 23-24.2 23-41s-8.7-32.2-23-41L73 39z"
                            ></path>
                        </svg>
                        {heroSecondaryCtaText}
                    </span>
                </a>
            </div>
            <div class="hero-perks">
                <p class="hero-notice">{settings.heroNotice || "Founding contractors get free access while we launch the beta."}</p>
                <ul class="hero-checklist">
                    <li>✓ Active project listings</li>
                    <li>✓ Residential and commercial opportunities</li>
                    <li>✓ Builder demand you can act on</li>
                    <li>✓ No bidding platform fees during beta</li>
                </ul>
            </div>
        </div>
        <div class="video-wrapper">
            <video
                id="heroVideo"
                class="media hero-video"
                preload="auto"
                poster={settings.heroVideoPoster || "hero-video-poster.webp"}
                autoplay
                loop
                muted
                playsinline
                webkit-playsinline
            >
                {mp4Url && <source src={mp4Url} type="video/mp4" />}
                {webmUrl && webmUrl !== mp4Url && <source src={webmUrl} type="video/webm" />}
            </video>
            <button
                type="button"
                id="heroVideoToggle"
                class="video-play-btn is-paused"
                aria-label="Reproducir o pausar video"
            >
                <svg class="icon-play" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M8 5v14l11-7z" />
                </svg>
                <svg class="icon-pause" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z" />
                </svg>
            </button>
        </div>
    </div>
</section>

<style>
    .hero {
        min-height: 100vh;
        min-height: 100dvh;
        padding-top: calc(var(--h-menu-bar) + var(--px-16));
        padding-bottom: var(--px-28);
        display: flex;
        align-items: center;
        box-sizing: border-box;
    }

    .hero-container {
        width: 100%;
        display: grid;
        grid-template-columns: 1.05fr 0.95fr;
        gap: var(--px-48);
        align-items: center;
    }

    .hero-content {
        max-width: 38rem;
    }

    .hero .section-tag {
        margin-bottom: var(--px-12);
        font-size: var(--text-xs);
        letter-spacing: 0.08em;
    }

    .hero-title {
        margin-bottom: var(--px-16);
        font-size: clamp(1.625rem, 2.6vw, 2.35rem);
        font-weight: 500;
        line-height: 1.18;
        letter-spacing: -0.02em;
    }

    .hero-subtitle {
        font-size: clamp(var(--text-xs), 1vw, var(--text-sm));
        margin-bottom: var(--px-20);
        line-height: 1.55;
        max-width: 34rem;
        color: var(--color-text-secondary);
    }

    .hero-cta {
        display: flex;
        gap: var(--px-16) var(--px-32);
        flex-wrap: wrap;
        align-items: center;
    }

    .btns--secondary {
        font-weight: 500;
        margin-top: 0;
        height: var(--px-36);
    }

    .btn--secondary {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: var(--px-8);
    }

    .btn--secondary svg {
        height: var(--px-16);
    }

    .video-wrapper {
        position: relative;
        width: 100%;
        height: 100%;
        max-height: min(34rem, 70vh);
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        cursor: pointer;
    }

    .video-wrapper video {
        width: 100%;
        height: 100%;
        max-height: min(34rem, 70vh);
        object-fit: cover;
    }

    .video-play-btn {
        position: absolute;
        bottom: var(--px-16);
        right: var(--px-16);
        width: 2.75rem;
        height: 2.75rem;
        border-radius: 50%;
        background: rgba(0, 0, 0, 0.65);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        border: 1px solid rgba(255, 255, 255, 0.25);
        color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        z-index: 5;
        transition: transform 0.2s ease, background 0.2s ease, opacity 0.3s ease;
        opacity: 0.85;
    }

    .video-play-btn:hover {
        transform: scale(1.08);
        background: rgba(0, 0, 0, 0.9);
        opacity: 1;
    }

    .video-play-btn svg {
        width: 1.25rem;
        height: 1.25rem;
    }

    .video-play-btn .icon-play {
        display: none;
        margin-left: 2px;
    }

    .video-play-btn .icon-pause {
        display: block;
    }

    .video-play-btn.is-paused .icon-play {
        display: block;
    }

    .video-play-btn.is-paused .icon-pause {
        display: none;
    }

    .video-wrapper:hover .video-play-btn {
        opacity: 1;
    }


    .hero-perks {
        margin-top: var(--px-20);
        padding-top: var(--px-16);
        border-top: 1px solid var(--color-border);
    }

    .hero-notice {
        font-size: 0.813rem;
        color: var(--color-text-secondary);
        margin-bottom: var(--px-8);
        font-weight: 500;
    }

    .hero-checklist {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--px-6) var(--px-16);
        list-style: none;
        padding: 0;
        margin: 0;
        font-size: 0.813rem;
        color: var(--color-text-dark);
        font-weight: 500;
    }

    @media screen and (max-height: 46.875rem) and (min-width: 59.375rem) {
        .hero {
            padding-top: calc(var(--h-menu-bar) + var(--px-8));
            padding-bottom: var(--px-16);
        }

        .hero-title {
            font-size: clamp(1.5rem, 2.2vw, 2rem);
            margin-bottom: var(--px-12);
        }

        .hero-subtitle {
            margin-bottom: var(--px-16);
        }

        .hero-perks {
            margin-top: var(--px-16);
            padding-top: var(--px-12);
        }

        .video-wrapper,
        .video-wrapper video {
            max-height: min(28rem, 65vh);
        }
    }

    @media screen and (max-width: 42rem) {
        .hero-checklist {
            grid-template-columns: 1fr;
        }
    }

    @media screen and (max-width: 64rem) {
        .hero-container {
            gap: var(--px-24);
        }

        .hero-content {
            max-width: 100%;
        }

        .hero-title {
            line-height: 1.25;
        }
    }

    @media screen and (max-width: 59.375rem) {
        .hero {
            min-height: auto;
            padding-top: calc(var(--h-menu-bar) + var(--px-32));
            padding-bottom: var(--px-48);
        }

        .hero-container {
            grid-template-columns: 1fr;
            gap: var(--px-32);
        }

        .hero-title {
            margin-bottom: var(--px-20);
        }

        .hero-subtitle {
            margin-bottom: var(--px-28);
        }

        .hero-cta {
            column-gap: var(--px-32);
        }

        .video-wrapper {
            min-height: 18.75rem;
            max-height: none;
        }

        .video-wrapper video {
            max-height: none;
        }
    }
</style>

<script>
    function initHeroVideo() {
        const video = document.getElementById("heroVideo") as HTMLVideoElement | null;
        const toggleBtn = document.getElementById("heroVideoToggle");
        if (!video) return;

        // Force muted properties required for iOS Safari & Android Autoplay
        video.muted = true;
        video.defaultMuted = true;
        video.playsInline = true;

        const syncState = () => {
            if (!toggleBtn) return;
            if (video.paused) {
                toggleBtn.classList.add("is-paused");
            } else {
                toggleBtn.classList.remove("is-paused");
            }
        };

        const tryPlay = () => {
            const playPromise = video.play();
            if (playPromise !== undefined) {
                playPromise
                    .then(() => {
                        syncState();
                    })
                    .catch(() => {
                        // Autoplay prevented (e.g. iOS low power mode or battery saver)
                        syncState();
                        // Trigger play on first user interaction anywhere on the screen
                        const startOnInteraction = () => {
                            video.play().catch(() => {});
                            syncState();
                        };
                        window.addEventListener("touchstart", startOnInteraction, { once: true });
                        window.addEventListener("click", startOnInteraction, { once: true });
                    });
            }
        };

        tryPlay();

        const togglePlayback = (e: Event) => {
            e.stopPropagation();
            if (video.paused) {
                video.play().catch(() => {});
            } else {
                video.pause();
            }
            syncState();
        };

        toggleBtn?.addEventListener("click", togglePlayback);
        video.addEventListener("click", togglePlayback);
        video.addEventListener("play", syncState);
        video.addEventListener("pause", syncState);
    }

    initHeroVideo();
    document.addEventListener("astro:page-load", initHeroVideo);
    document.addEventListener("astro:after-swap", initHeroVideo);
</script>

