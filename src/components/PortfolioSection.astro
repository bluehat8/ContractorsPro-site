---
import BaseSwiper from "./BaseSwiper.astro";
import { Image } from "astro:assets";
import { getProjects } from "../lib/sanity/api";

const projects = await getProjects();
---

<section id="projects" class="portfolio">
    <div id="opportunities" class="section-container">
        <span class="section-tag">OPPORTUNITIES & PROJECTS</span>
        <h2 class="section-title">Spend less time chasing work and more time reviewing projects.</h2>
        <BaseSwiper sliderName="portfolio" beforeAfter>
            {
                projects.map((project) => {
                    const isBeforeString = typeof project.beforeImage === 'string';
                    const isAfterString = typeof project.afterImage === 'string';

                    return (
                        <div class="swiper-slide">
                            <div class="project-image">
                                {isBeforeString ? (
                                    <img
                                        class="image before"
                                        src={project.beforeImage}
                                        alt={project.beforeImageAlt || project.title}
                                        aria-hidden="true"
                                    />
                                ) : (
                                    <Image
                                        class="image before"
                                        src={project.beforeImage}
                                        alt={project.beforeImageAlt || project.title}
                                        width={800}
                                        aria-hidden="true"
                                    />
                                )}
                                {isAfterString ? (
                                    <img
                                        class="image after active"
                                        src={project.afterImage}
                                        alt={project.afterImageAlt || project.title}
                                        aria-hidden="false"
                                    />
                                ) : (
                                    <Image
                                        class="image after active"
                                        src={project.afterImage}
                                        alt={project.afterImageAlt || project.title}
                                        width={1144}
                                        height={800}
                                        aria-hidden="false"
                                    />
                                )}
                            </div>
                            <div class="project-info">
                                <div class="info-section">
                                    <h3 class="section-subtitle info-title">
                                        {project.challengeTitle || "Active Project Listings"}
                                    </h3>
                                    <p class="info-text">
                                        {project.challengeText}
                                    </p>
                                </div>
                                <div class="info-section">
                                    <h3 class="section-subtitle info-title">
                                        {project.resultTitle || project.title}
                                    </h3>
                                    <p class="info-text">
                                        {project.resultText || `${project.location} • Scope: ${project.scope}`}
                                    </p>
                                </div>
                            </div>
                        </div>
                    );
                })
            }
        </BaseSwiper>
    </div>
</section>

<style>
    :global(.portfolio-swiper) {
        padding-inline: var(--px-64);
        position: relative;
    }

    .swiper-slide {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--px-48);
        opacity: 0;
        transform: scale(0.75);
        transition: all var(--transition-long);
    }

    .swiper-slide-active {
        opacity: 1;
        transform: scale(1);
    }

    .swiper-slide-prev,
    .swiper-slide-next {
        opacity: 0;
        transform: scale(0.75);
    }

    .project-image {
        position: relative;
        min-height: 22rem;
        overflow: hidden;
    }

    .image {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        opacity: 0;
        transition: opacity var(--transition-long);
    }

    .image.active {
        opacity: 1;
    }

    .project-info {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: var(--px-24);
    }

    .info-section {
        display: flex;
        flex-direction: column;
        gap: var(--px-12);
    }

    .info-title {
        margin-bottom: 0;
    }

    .view-details {
        display: inline-flex;
        font-weight: 500;
        margin-top: auto;
    }

    .btn--secondary {
        border-bottom: var(--px-2) solid currentColor;
    }

    .btn--secondary-hovered {
        display: block;
    }

    @media screen and (max-width: 64rem) {
        .swiper-slide {
            gap: var(--px-32);
        }
    }

    @media screen and (max-width: 55rem) {
        :global(.portfolio-swiper) {
            padding-inline: 0;
        }

        .swiper-slide {
            grid-template-columns: 1fr;
            gap: var(--px-32);
        }
    }
</style>

<script>
    import { initSwiper } from "@utils/initSwiper";

    function initPortfolioSlider() {
        const portfolioSwiper = initSwiper("portfolio", {
            spaceBetween: 30,
            navigation: {
                nextEl: ".portfolio-next",
                prevEl: ".portfolio-prev",
            },
            pagination: {
                el: ".portfolio-pagination",
                clickable: true,
            },
        });

        const updateSlideView = (view: string, slide: HTMLElement) => {
            const images = slide.querySelectorAll(".image");

            images.forEach((img) => {
                if (img.classList.contains(view)) {
                    img.classList.add("active");
                    img.setAttribute("aria-hidden", "false");
                } else {
                    img.classList.remove("active");
                    img.setAttribute("aria-hidden", "true");
                }
            });
        };

        document.addEventListener("click", (e) => {
            const btn = (e.target as HTMLElement).closest<HTMLButtonElement>(
                ".toggle-btn",
            );
            if (!btn) return;

            document
                .querySelector(".toggle-btn.active")
                ?.classList.remove("active");
            btn.classList.add("active");

            const view = btn.dataset.view;
            const currentSlide =
                portfolioSwiper.slides[portfolioSwiper.activeIndex];
            if (currentSlide && view) updateSlideView(view, currentSlide);
        });

        portfolioSwiper.on("slideChangeTransitionStart", () => {
            const activeSlide =
                portfolioSwiper.slides[portfolioSwiper.activeIndex];
            if (activeSlide) updateSlideView("after", activeSlide);

            document
                .querySelector(".toggle-btn.active")
                ?.classList.remove("active");
            document
                .querySelector('.toggle-btn[data-view="after"]')
                ?.classList.add("active");
        });

        return () => {
            portfolioSwiper.destroy();
        };
    }

    let cleanup = initPortfolioSlider();

    document.addEventListener("astro:after-swap", () => {
        if (cleanup) cleanup();
        cleanup = initPortfolioSlider();
    });
</script>
