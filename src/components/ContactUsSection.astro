---
import { SITE } from '@consts';

const servicesCol1 = [
  "Roofing",
  "HVAC",
  "Drywall",
  "Painting",
  "Remodeling",
  "Trim",
  "Flooring",
  "Tile",
  "Landscaping",
];

const servicesCol2 = [
  "Electric",
  "Concrete",
  "Framing",
  "Plumbing",
  "Carpentry",
  "Countertops",
  "Staircases",
  "Cleaning",
  "And More",
];
---

<section id="contact" class="contact">
  <div id="beta" class="section-container contact-container">
    <div class="contact-top">
      <div class="contact-top-left">
        <span class="section-tag">FOUNDING ACCESS</span>
        <h2 class="section-title">
          Become a Founding Contractor.
        </h2>
        <p class="contact-desc">
          We're onboarding a limited group of subcontractors before public launch. Tell us about your services, crew capacity, and the compliance details builders typically need.
        </p>
      </div>

      <address class="contact-top-right contact-info">
        <div>
          <div class="contact-icon">
            <svg
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
              xmlns="http://www.w3.org/2000/svg"
              fill-rule="evenodd"
              clip-rule="evenodd"
            >
              <path
                d="M24 21h-24v-18h24v18zm-23-16.477v15.477h22v-15.477l-10.999 10-11.001-10zm21.089-.523h-20.176l10.088 9.171 10.088-9.171z"
              ></path>
            </svg>
            <div class="contact-icon-s">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
              >
                <path
                  d="M12 0c-6.627 0-12 5.373-12 12s5.373 12 12 12 12-5.373 12-12-5.373-12-12-12zm3.445 17.827c-3.684 1.684-9.401-9.43-5.8-11.308l1.053-.519 1.746 3.409-1.042.513c-1.095.587 1.185 5.04 2.305 4.497l1.032-.505 1.76 3.397-1.054.516z"
                ></path>
              </svg>
            </div>
          </div>
          <h3 class="contact-subtitle">Subcontractor Support</h3>
          <div class="contact-details">
            <a href=`mailto:${SITE.EMAIL}` class="contact-detail contact-email"
              >{SITE.EMAIL}</a
            >
            <a href=`tel:${SITE.TELEPHONE}` class="contact-detail contact-phone"
              >{SITE.TELEPHONE}</a
            >
          </div>
        </div>
        <div>
          <div class="contact-icon">
            <svg
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
              xmlns="http://www.w3.org/2000/svg"
              fill-rule="evenodd"
              clip-rule="evenodd"
            >
              <path
                d="M12 10c-1.104 0-2-.896-2-2s.896-2 2-2 2 .896 2 2-.896 2-2 2m0-5c-1.657 0-3 1.343-3 3s1.343 3 3 3 3-1.343 3-3-1.343-3-3-3m-7 2.602c0-3.517 3.271-6.602 7-6.602s7 3.085 7 6.602c0 3.455-2.563 7.543-7 14.527-4.489-7.073-7-11.072-7-14.527m7-7.602c-4.198 0-8 3.403-8 7.602 0 4.198 3.469 9.21 8 16.398 4.531-7.188 8-12.2 8-16.398 0-4.199-3.801-7.602-8-7.602"
              ></path>
            </svg>
          </div>
          <h3 class="contact-subtitle">Coverage</h3>
          <span class="contact-detail">United States • Nationwide Network</span>
        </div>
      </address>
    </div>

    <div class="contact-bottom">
      <form class="contact-form" action="">
        <div class="contact-form-fields">
          <div class="form-group">
            <label class="form-label" for="name">Contact Name</label>
            <input
              class="form-input"
              id="name"
              type="text"
              placeholder="Your full name"
              required
            />
          </div>
          <div class="form-group">
            <label class="form-label" for="company">Company / Business Name</label>
            <input
              class="form-input"
              id="company"
              type="text"
              placeholder="e.g. Apex Roofing LLC"
              required
            />
          </div>
          <div class="form-group">
            <label class="form-label" for="email">Business Email</label>
            <input
              class="form-input"
              id="email"
              type="email"
              placeholder="your@company.com"
              required
            />
          </div>
          <div class="form-group">
            <label class="form-label" for="phone">Phone Number</label>
            <input
              class="form-input"
              id="phone"
              type="tel"
              placeholder="(555) 000-0000"
              required
            />
          </div>
          <div class="form-group full-width">
            <label class="form-label" for="location">Service Area / Zip Code</label>
            <input
              class="form-input"
              id="location"
              type="text"
              placeholder="e.g. Austin, TX or 78701"
              required
            />
          </div>

          <!-- What services do you offer? Section -->
          <div class="form-group full-width services-section">
            <label class="form-label services-title">What services do you offer?</label>
            <div class="services-columns">
              <div class="services-col">
                {servicesCol1.map((service) => (
                  <label class={`service-card ${service === "Roofing" ? "is-checked" : ""}`}>
                    <input
                      type="checkbox"
                      name="services"
                      value={service}
                      class="service-input"
                      checked={service === "Roofing"}
                    />
                    <span class="service-name">{service}</span>
                  </label>
                ))}
              </div>
              <div class="services-col">
                {servicesCol2.map((service) => (
                  <label class="service-card">
                    <input
                      type="checkbox"
                      name="services"
                      value={service}
                      class="service-input"
                    />
                    <span class="service-name">{service}</span>
                  </label>
                ))}
              </div>
            </div>
          </div>

          <!-- Insurance & TIN W-9 Questions Row -->
          <div class="form-group full-width compliance-row">
            <div class="compliance-box">
              <label class="form-label">Do you have a certificate of insurance?</label>
              <div class="radio-pill-group">
                <label class="radio-card is-checked">
                  <input type="radio" name="insurance" value="yes" checked class="compliance-radio" />
                  <span class="radio-label">Yes</span>
                </label>
                <label class="radio-card">
                  <input type="radio" name="insurance" value="no" class="compliance-radio" />
                  <span class="radio-label">No</span>
                </label>
              </div>
            </div>

            <div class="compliance-box">
              <label class="form-label">
                Do you have a Taxpayer Identification Number? <span class="subtext-note">(For a W-9 Form)</span>
              </label>
              <div class="radio-pill-group">
                <label class="radio-card is-checked">
                  <input type="radio" name="tin" value="yes" checked class="compliance-radio" />
                  <span class="radio-label">Yes</span>
                </label>
                <label class="radio-card">
                  <input type="radio" name="tin" value="no" class="compliance-radio" />
                  <span class="radio-label">No</span>
                </label>
              </div>
            </div>
          </div>

          <div class="form-group message-group full-width">
            <label class="form-label" for="message">Crew Capacity & Notes (Optional)</label>
            <textarea
              class="form-input form-textarea"
              id="message"
              placeholder="Describe your crew size, active licenses, or specific project types you prefer..."
              rows="3"></textarea>
          </div>
        </div>

        <div class="form-submit">
          <button type="submit" class="btn btn--primary">JOIN FREE BETA ACCESS</button>
          <div class="contact-terms">
            <span class="contact-terms-icon">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                ><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"
                ></path><path d="M12 8h.01"></path></svg
              >
            </span>
            Founding contractors receive free access during beta launch. By submitting you agree to the
            <a class="text-link" href="legal/terms">Terms & Conditions</a> and
            <a class="text-link" href="legal/privacy">Privacy Policy</a>.
          </div>
        </div>
        <div id="form-feedback" class="form-feedback" hidden>
          <p>Thank you! Your beta application has been received. Our team will contact you shortly.</p>
        </div>
      </form>

      <!-- Side info card -->
      <div class="contact-side-info">
        <div class="side-info-card">
          <span class="section-tag">BETA HIGHLIGHTS</span>
          <h3 class="side-info-title">Why Subcontractors Join ContractorPro</h3>
          <p class="side-info-desc">
            We are onboarding a limited group of qualified trade specialists before our public launch across the United States.
          </p>

          <div class="side-perks">
            <div class="side-perk-item">
              <span class="side-perk-badge">01</span>
              <div>
                <h4 class="side-perk-title">Active Project Listings</h4>
                <p class="side-perk-text">Browse residential and commercial construction opportunities looking for trades right now.</p>
              </div>
            </div>

            <div class="side-perk-item">
              <span class="side-perk-badge">02</span>
              <div>
                <h4 class="side-perk-title">Zero Bidding Fees</h4>
                <p class="side-perk-text">Founding contractors get 100% free access while we launch the beta.</p>
              </div>
            </div>

            <div class="side-perk-item">
              <span class="side-perk-badge">03</span>
              <div>
                <h4 class="side-perk-title">Direct Builder Contact</h4>
                <p class="side-perk-text">Builders review your trade credentials and reach out directly to coordinate walkthroughs.</p>
              </div>
            </div>
          </div>

          <div class="side-trust-footer">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            </svg>
            <span>Applications are reviewed within 24–48 hours for founding contractor verification.</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .contact {
    display: grid;
  }

  .section-container.contact-container {
    display: grid;
    grid-template-rows: auto auto;
  }

  .contact-top,
  .contact-bottom {
    gap: var(--px-32);
  }

  .contact-top {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  .contact-desc {
    max-width: 32rem;
    color: var(--color-text-secondary);
    margin-top: -0.75rem;
    margin-bottom: 1.5rem;
    font-size: var(--text-sm);
    line-height: 1.55;
  }

  .contact-bottom {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    align-items: start;
  }

  .contact-top-left,
  .contact-form {
    margin-right: var(--px-32);
  }

  .contact-form-fields {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--px-16);
    margin-bottom: var(--px-24);
  }

  .form-group {
    display: grid;
    gap: var(--px-6);
  }

  .form-group.full-width {
    grid-column: 1 / -1;
  }

  .form-label {
    font-size: 0.938rem;
    font-weight: 500;
    color: var(--color-text-primary);
  }

  .form-input {
    color: var(--color-text-primary);
    padding: var(--px-12) var(--px-16);
    box-shadow: none;
    border: 1px solid var(--color-border);
    transition: all var(--transition-short);
    font-size: var(--text-sm);
    border-radius: var(--radius-sm);
    background-color: var(--color-white);
    font-family: inherit;
  }

  .form-input:focus {
    color: var(--color-primary);
    border-color: var(--color-border-focus);
    box-shadow: 0 0 3px rgba(0, 0, 0, 0.2);
    outline: none;
  }

  /* Services Checklist Styling - 100% matched to template aesthetic */
  .services-section {
    margin-top: var(--px-6);
  }

  .services-title {
    font-size: 0.938rem;
    font-weight: 500;
    margin-bottom: var(--px-6);
    color: var(--color-text-primary);
  }

  .services-columns {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--px-10);
  }

  .services-col {
    display: flex;
    flex-direction: column;
    gap: var(--px-6);
  }

  .service-card {
    display: flex;
    align-items: center;
    gap: var(--px-10);
    padding: var(--px-10) var(--px-14);
    background-color: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: all var(--transition-short);
    user-select: none;
  }

  .service-card:hover {
    border-color: var(--color-border-hover);
    background-color: var(--color-background);
  }

  .service-input {
    appearance: none;
    -webkit-appearance: none;
    width: 18px;
    height: 18px;
    border: 1px solid rgba(0, 0, 0, 0.25);
    border-radius: 3px;
    background-color: var(--color-white);
    display: grid;
    place-content: center;
    cursor: pointer;
    flex-shrink: 0;
    transition: all var(--transition-short);
    margin: 0;
  }

  .service-input::before {
    content: "";
    width: 8px;
    height: 5px;
    border-left: 2px solid var(--color-white);
    border-bottom: 2px solid var(--color-white);
    transform: rotate(-45deg) translate(1px, -1px);
    opacity: 0;
    transition: opacity var(--transition-short);
  }

  .service-input:checked {
    background-color: var(--color-primary);
    border-color: var(--color-primary);
  }

  .service-input:checked::before {
    opacity: 1;
  }

  .service-card:has(.service-input:checked),
  .service-card.is-checked {
    background-color: var(--color-background);
    border-color: var(--color-primary);
  }

  .service-card:has(.service-input:checked) .service-name,
  .service-card.is-checked .service-name {
    color: var(--color-primary);
    font-weight: 600;
  }

  .service-name {
    font-size: var(--text-sm);
    color: var(--color-text-primary);
    font-family: inherit;
    transition: color var(--transition-short);
  }

  /* Compliance Radio Pills - 100% matched to template aesthetic */
  .compliance-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--px-20);
    margin-top: var(--px-8);
    align-items: stretch;
  }

  .compliance-box {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .compliance-box .form-label {
    font-size: 0.938rem;
    font-weight: 500;
    color: var(--color-text-primary);
    line-height: 1.35;
    margin-bottom: var(--px-8);
    min-height: 2.75rem;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
  }

  .subtext-note {
    display: block;
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    font-weight: 400;
    line-height: 1.3;
  }

  .radio-pill-group {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--px-12);
    margin-top: auto;
  }

  .radio-card {
    display: flex;
    align-items: center;
    gap: var(--px-10);
    padding: var(--px-10) var(--px-16);
    background-color: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: all var(--transition-short);
    user-select: none;
  }

  .radio-card:hover {
    border-color: var(--color-border-hover);
    background-color: var(--color-background);
  }

  .compliance-radio {
    appearance: none;
    -webkit-appearance: none;
    width: 18px;
    height: 18px;
    border: 1px solid rgba(0, 0, 0, 0.25);
    border-radius: 50%;
    background-color: var(--color-white);
    display: grid;
    place-content: center;
    cursor: pointer;
    flex-shrink: 0;
    transition: all var(--transition-short);
    margin: 0;
  }

  .compliance-radio::before {
    content: "";
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--color-primary);
    opacity: 0;
    transition: opacity var(--transition-short);
  }

  .compliance-radio:checked {
    border-color: var(--color-primary);
  }

  .compliance-radio:checked::before {
    opacity: 1;
  }

  .radio-card:has(.compliance-radio:checked),
  .radio-card.is-checked {
    background-color: var(--color-background);
    border-color: var(--color-primary);
  }

  .radio-card:has(.compliance-radio:checked) .radio-label,
  .radio-card.is-checked .radio-label {
    color: var(--color-primary);
    font-weight: 600;
  }

  .radio-label {
    font-size: var(--text-sm);
    color: var(--color-text-primary);
    font-family: inherit;
  }

  .form-group.message-group {
    grid-column: 1 / -1;
  }

  .contact-info {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--px-24);
    font-style: normal;
    margin-bottom: var(--px-56);
  }

  .contact-info > div {
    position: relative;
    padding-left: var(--px-24);
  }

  .contact-info > div::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    height: 100%;
    width: 1px;
    background-color: rgba(0, 0, 0, 0.1);
  }

  .form-submit {
    display: flex;
    gap: var(--px-16);
    align-items: center;
    justify-content: space-between;
  }

  .form-feedback {
    margin-top: var(--px-24);
    color: #006600;
    font-weight: 500;
    animation: var(--transition-long);
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(-5px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .contact-terms {
    font-size: var(--text-xs);
    max-width: 20rem;
    line-height: 1.5;
  }

  .contact-terms-icon svg {
    display: inline;
    width: var(--text-base);
    margin-bottom: var(--px-2);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .contact-subtitle {
    font-size: var(--text-xl);
    margin-bottom: var(--px-12);
    font-weight: 500;
  }

  .contact-detail {
    display: block;
    opacity: 0.8;
    font-size: var(--text-sm);
    transition: opacity var(--transition-short);
  }

  .contact-detail:active {
    opacity: 1;
  }

  .contact-email {
    margin-bottom: var(--px-6);
  }

  .contact-icon {
    position: relative;
    display: inline-grid;
    margin-bottom: 1.375rem;
  }

  .contact-icon svg:first-of-type {
    width: var(--px-48);
  }

  .contact-icon-s {
    position: absolute;
    display: grid;
    top: -15%;
    right: -55%;
  }

  /* Side Info Card (replacing external map) */
  .contact-side-info {
    width: 100%;
    height: 100%;
  }

  .side-info-card {
    background-color: var(--color-background);
    padding: var(--px-40);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .side-info-title {
    font-size: var(--text-2xl);
    font-weight: 500;
    line-height: 1.25;
    margin-top: var(--px-16);
    margin-bottom: var(--px-12);
    color: var(--color-text-primary);
  }

  .side-info-desc {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: var(--px-32);
  }

  .side-perks {
    display: flex;
    flex-direction: column;
    gap: var(--px-24);
    margin-bottom: var(--px-40);
  }

  .side-perk-item {
    display: flex;
    gap: var(--px-16);
    align-items: flex-start;
  }

  .side-perk-badge {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--color-white);
    border: 1px solid var(--color-border);
    color: var(--color-primary);
    font-size: var(--text-xs);
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .side-perk-title {
    font-size: var(--text-base);
    font-weight: 500;
    color: var(--color-text-primary);
    margin-bottom: var(--px-4);
  }

  .side-perk-text {
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    line-height: 1.5;
    margin: 0;
  }

  .side-trust-footer {
    margin-top: auto;
    padding-top: var(--px-24);
    border-top: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    gap: var(--px-12);
    font-size: var(--text-xs);
    color: var(--color-text-dark);
    font-weight: 500;
  }

  .side-trust-footer svg {
    color: var(--color-primary);
    flex-shrink: 0;
  }

  @media (hover: hover) and (pointer: fine) {
    .contact-detail:hover {
      opacity: 1;
    }

    .form-input:hover {
      border-color: var(--color-border-hover);
    }
  }

  @media (max-width: 72.5rem) {
    .contact-form {
      margin-right: 0;
    }
  }

  @media (max-width: 66.5rem) {
    .contact-top {
      grid-template-columns: 1fr;
    }

    .contact-bottom {
      grid-template-columns: 1fr;
    }

    .form-submit {
      flex-direction: column;
      align-items: start;
    }
  }

  @media (max-width: 48rem) {
    .contact-form-fields {
      grid-template-columns: 1fr;
    }

    .services-columns {
      grid-template-columns: 1fr;
    }

    .compliance-row {
      grid-template-columns: 1fr;
      gap: var(--px-20);
    }

    .compliance-box .form-label {
      min-height: auto;
    }
  }

  @media (max-width: 35rem) {
    .contact-info {
      grid-template-columns: 1fr;
      gap: var(--px-32);
    }

    .side-info-card {
      padding: var(--px-24);
    }
  }
</style>

<script>
  // Dynamic visual selection
  document.querySelectorAll('.service-input').forEach(input => {
    input.addEventListener('change', (e) => {
      const target = e.target as HTMLInputElement;
      const card = target.closest('.service-card');
      card?.classList.toggle('is-checked', target.checked);
    });
  });

  document.querySelectorAll('.compliance-radio').forEach(radio => {
    radio.addEventListener('change', (e) => {
      const target = e.target as HTMLInputElement;
      const groupName = target.name;
      document.querySelectorAll(`input[name="${groupName}"]`).forEach(r => {
        const rCard = (r as HTMLInputElement).closest('.radio-card');
        rCard?.classList.toggle('is-checked', (r as HTMLInputElement).checked);
      });
    });
  });

  document
    .querySelector('.contact-form')
    ?.addEventListener('submit', async e => {
      e.preventDefault();

      const form = e.target as HTMLFormElement;
      const feedback = document.getElementById('form-feedback');
      const submitButton = form.querySelector(
        'button[type="submit"]'
      ) as HTMLButtonElement;

      if (!feedback || !submitButton) return;

      submitButton.disabled = true;
      const originalText = submitButton.textContent;
      submitButton.textContent = 'SUBMITTING...';

      await new Promise(resolve => setTimeout(resolve, 1200));

      feedback.hidden = false;

      form.reset();
      // reset visual state
      document.querySelectorAll('.service-card').forEach(c => c.classList.remove('is-checked'));
      document.querySelectorAll('.radio-card').forEach(c => c.classList.remove('is-checked'));
      document.querySelector('.service-card:first-child')?.classList.add('is-checked');
      document.querySelectorAll('.radio-card:first-child').forEach(c => c.classList.add('is-checked'));

      submitButton.textContent = originalText;
      submitButton.disabled = false;

      setTimeout(() => {
        feedback.hidden = true;
      }, 5000);
    });
</script>
